{
  "name": "tunet-dashboard",
  "private": true,
  "version": "1.25.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oyvhov/tunet.git"
  },
  "license": "GPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.js",
    "dev:all": "concurrently \"vite\" \"node server/index.js\"",
    "server": "node server/index.js",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "postbuild": "node scripts/postbuild.js",
    "preview": "vite preview",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md,yml,yaml,mjs,cjs,html}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md,yml,yaml,mjs,cjs,html}\"",
    "lint": "eslint src && node scripts/check-js-baseline.mjs",
    "lint:theme-colors": "node scripts/lint-theme-colors.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "typecheck": "node node_modules/typescript7/bin/tsc -p tsconfig.typecheck.json --noEmit && node node_modules/typescript7/bin/tsc -p tsconfig.server.json --noEmit && node node_modules/typescript7/bin/tsc -p tsconfig.strict.json --noEmit",
    "i18n:check": "vitest run src/__tests__/i18n.test.js",
    "test:watch": "vitest",
    "release:prep": "node scripts/release.mjs prep",
    "release:check": "node scripts/release.mjs check",
    "release:cut": "node scripts/release.mjs cut",
    "release:publish": "node scripts/release.mjs publish",
    "release": "npm run release:check ; npm run test ; npm run build ; npm run release:publish"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "hls.js": "^1.7.3",
    "home-assistant-js-websocket": "^9.7.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.59.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
